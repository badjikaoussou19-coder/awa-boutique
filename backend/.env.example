PORT=5000
# MongoDB local ou URI MongoDB Atlas (mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/ecommerce)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# Longue phrase secrète unique : générez-en une avec  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_phrase_secrete_unique
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Dossier des images envoyées (en production : un disque persistant). Par défaut : backend/uploads
# UPLOADS_DIR=/data/uploads
# Compte qui devient « administrateur du projet » au premier démarrage (sinon : le plus ancien administrateur)
# OWNER_EMAIL=admin@boutik.sn

# ───── Connexion avec Google / Facebook / GitHub (facultatif : un fournisseur est activé quand ses deux valeurs sont remplies)
# Adresse publique du backend (sert à bâtir l'adresse de retour : <API_URL>/api/auth/oauth/<fournisseur>/callback)
# API_URL=http://localhost:5000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ───── Sécurité (facultatif)
# Durée des sessions du personnel (administrateurs) ; les clients utilisent JWT_EXPIRES_IN
# STAFF_JWT_EXPIRES_IN=12h
# Clé de chiffrement des secrets de double authentification (par défaut : dérivée de JWT_SECRET)
# DATA_KEY=
# En production, JWT_SECRET doit faire au moins 32 caractères aléatoires (le serveur refuse de démarrer sinon).
# Générer un secret :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
